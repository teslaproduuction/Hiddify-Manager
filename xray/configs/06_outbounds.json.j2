{
  "outbounds": [
    {
      {%if hconfigs["only_ipv4"]%}
      "domainStrategy":"UseIPv4v6",
      {%endif%}
      "tag": "freedom",
      "protocol": "freedom",
      "settings": {

      }
    },
    {
      {%if hconfigs["only_ipv4"]%}
      "domainStrategy":"UseIPv4v6",
      {%endif%}
      "tag": "WARP",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "tcpFastOpen": true,
          "interface": "warp"
        }
      }
    },
    // {
